 "blocks": [
  {
   "id": "wakayama-bokusui-916448-0001",
   "pid": "916448",
   "pages": [
    3
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "室に高窓ありて東に面すさやさやにその音ながれつ窓ごしに見上ぐれば靑葉瀧とそよげり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0002",
   "pid": "916448",
   "pages": [
    4
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "やはらけき欅のわか葉さざなみなし流れて窓にそよぎたるかも晴れし日の机の上ふつとして眼につけるかも黑塗の一閑張にうつれる靑葉",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0003",
   "pid": "916448",
   "pages": [
    5
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "置かれたる酒杯のさけにもこまごまと靜けき靑葉うつりたるかななみなみと滿ちたる酒をながめつつ時惜む間も心靜まらず曇り日の窓ゆさゆさと搖れ立つ重き葉のひびきうす暗き窓のうちに聞ゆる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0004",
   "pid": "916448",
   "pages": [
    6
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ひとしきり風に吹かれてしなえたるあを葉の陰のひるすぎの窓靑臭き香さへ漏れ來て曇り日の窓邊のわか葉風立つらしも風と日光と靜けさ或時は雨かとも聞ゆ窓押せばかはることなき欅のひかり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0005",
   "pid": "916448",
   "pages": [
    7
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "眞晝雀啼くなんといふそのたのしげのほしいままなる啼聲かいま大樹さやさやにさやぐ靑葉の枝見つつ沖の白浪おもひゐにけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0006",
   "pid": "916448",
   "pages": [
    8
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "欅靑葉さやける見れば額あげてわれも大きく眸張るべかり夏漸く深し日ごと日ごと黒みかたまる窓の前の欅のわか葉見つつ惜めり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0007",
   "pid": "916448",
   "pages": [
    9
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "とほり雨通り雨葉かげにそそぎ朝風のさやぎもつるる窓邊より見ゆ夏の疲勞",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0008",
   "pid": "916448",
   "pages": [
    10
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "家の近くに伐り殘されし楢の林ありあたりみな鏡のごとき明るさに靑葉はいまし搖れそめにけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0009",
   "pid": "916448",
   "pages": [
    11
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "靑嵐立たむとならし楢の葉のきらりきらりと朝日に光る悲しきはわが疲れなりいつしんに事を爲さむとおもひ立つそのたまゆらは樂しきものを",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0010",
   "pid": "916448",
   "pages": [
    12
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "倦怠か疲勞かともすれば外れがちなるこころの破目けふもはづれて一日暮るる熟れすぎしいちご林檎のたぐひにや饐えし欠伸のまたしても出づ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0011",
   "pid": "916448",
   "pages": [
    13
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "たそがれ疲れはてて歸り來れば珍しきもの見るごとくつどふ妻子ら靜夜けふもまた誰も來ざりき斯くおもひこころ安らかに戶は閉すなり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0012",
   "pid": "916448",
   "pages": [
    14
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夏の東明のたのしさよ午前四時五時まだ過ぎずしののめの靄降れる間のわれのたのしさけだるさを叱り叱りて起き出づるしののめの空に靄深く降れり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0013",
   "pid": "916448",
   "pages": [
    15
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "をりをりの朝寢あはれはれ雨かも降ると起き出でて見ればけうとき靑葉のひかり一人の舊友かかることいふべくもあらぬ男より斯くさびしげの手紙來にけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0014",
   "pid": "916448",
   "pages": [
    16
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "畫を恐るとかくして朝七時すぎ八時九時過ぎゆくなべに世はひかりなりあかつき竹煮草あをじろき葉の廣き葉のつゆをさけつつ小蟻あそべり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0015",
   "pid": "916448",
   "pages": [
    17
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "或る家の二階がらす戶にふりかかる雨の三粒四粒かずわかずなりて搖るる大枝木下みちしつとりと垂れて動かぬ曇り日のわか葉の枝をくぐるさびしも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0016",
   "pid": "916448",
   "pages": [
    18
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夏の朝朝の街いそぎ通ればをちこちに靑葉そよぎゐて酒ほしくなれり夏の夕親しさや日ごとつかれてわが通る貧民窟の夏のたそがれ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0017",
   "pid": "916448",
   "pages": [
    19
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "わびしき朝夕父の眼のつめたき光うつつなき兒にもわかるか見ればさびしげいふことはすべて空しと誓ひつつさりとても身のただにさびしく",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0018",
   "pid": "916448",
   "pages": [
    20
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "池袋村麥畑のくろにならべる四五本の桃のわか木に實のなれる見ゆ何といふ蟲のおほさぞ花しろき大根ばたけの土みてあれば麥ばたの垂り穗のうへにかげ見えて電車過ぎゆく池袋村",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0019",
   "pid": "916448",
   "pages": [
    21
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "黃楊の木のはなの眞白さうとうとと坂を登れば植木屋の籬に妙義山",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0020",
   "pid": "916448",
   "pages": [
    22
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "その日妙義山に志したれど心變りて磯部に泊る氣まぐれの途中下車して温泉町停車場出れば葉ざくら暗し",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0021",
   "pid": "916448",
   "pages": [
    23
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "眼に立たぬ宿屋さがして温泉町さまよひ行けば河鹿なくなり湯の町の葉ざくら暗きまがり坂曲り下れば溪川の見ゆ町端れの宿屋に入れば心の疲れ俄かに身に浸む思ひすひとり來てひそかに泊る湯の宿の緣に出れば溪川の見ゆ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0022",
   "pid": "916448",
   "pages": [
    24
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "溪川の見ゆるうれしみひろびろと部屋あけ放ち居ればうら寒し河鹿しきりになく碓氷川川原をひろみかたよりて流るる瀨々に河鹿なくなり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0023",
   "pid": "916448",
   "pages": [
    25
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "旅なれぬ身にもあらねどはるかにも來つるおもひの旅心地宿屋の窓に杉の山見ゆその翌朝川上の妙義巖山白雲のおくにこもりてこの朝見えず",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0024",
   "pid": "916448",
   "pages": [
    26
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "朝夙く出で立たむとおもひしがみなかみの峰にかかれるしら雲のいちじろくなりて晝たけにけり翌々日磯部を出で高原の路を歩きて妙義山に向ふ行き行けば靑桑畑ひとすぢの道をかこみて盡きむともせず",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0025",
   "pid": "916448",
   "pages": [
    27
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "みちばたの桑の葉かげに腰おろし煙草すひ居れば霧降り來るその山は雲にかくれつ妙義道直きかぎりに桑畑曇るこのあたりの村すべて蠶を飼へるにや妙義道たまたま逢へるいちにんのをんな靑桑を背負ひ急げり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0026",
   "pid": "916448",
   "pages": [
    28
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "水無月の朝霧寒み戶をおろしこもれる村を行けば蠶の匂道漸く山に懸れば霧は雨とかはれり道ややに登りとなれば桑畑のをりをり斷えて雜木の林",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0027",
   "pid": "916448",
   "pages": [
    29
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "はらはらと雜木林に雨來り音あらきなかにほととぎす啼く妙義町なる宿屋に雲と雨とを眺め暮すこと三日間杉山のわか葉の溪の雨を繁みはるかなるかもその瀧の音",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0028",
   "pid": "916448",
   "pages": [
    30
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "向つ山杉生のうへに居る雲のなびき動きて雨降りしきるひとしきり明るくなりて降る雨の向つ杉山雲立ちわたる僅かの晴間を見てその峰に登りぬ雲しろくよどみ動かぬあめつちの深きがなかに岩ふみて立つ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0029",
   "pid": "916448",
   "pages": [
    31
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "秩父嶺のうねりの端か低く見えてただよへる雲は四方をとざせり此處に浮ぶ峰のとがりにわれ居りて見はるかせば四方を雲とざしたり雲深くとざせる溪の奧所よりいよいよ冴えて水の聞ゆる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0030",
   "pid": "916448",
   "pages": [
    32
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "山を下らむといふ日に溪々にひそみ靜まり白雲のこの朝立たず峰晴れにけり溪をおもふ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0031",
   "pid": "916448",
   "pages": [
    33
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "身の故にや時の故にや此頃おほく溪をおもふ疲れはてしこころの底に時ありてさやかにうかぶ溪のおもかげ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0032",
   "pid": "916448",
   "pages": [
    34
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "何處とはさだかにわかねわがこころさびしき時に溪川の見ゆ溪を思ふは畢竟孤獨をおもふ心か獨り居て見まほしきものは山かげの巖が根ゆける細溪の水",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0033",
   "pid": "916448",
   "pages": [
    35
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "巖が根につくばひ居りて聽かまほしおのづからなるその溪の音溪をおもへばわがこころ常にうるほふ五百重山峰にしら雲立たぬ日もひびきすずしきその溪をおもふ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0034",
   "pid": "916448",
   "pages": [
    36
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "わが居ればわが居るところ眞がなしき音に出でつつ見ゆる溪川いろいろと考ふるに心に浮ぶは故郷の溪間なり幼き日ふるさとの山に睦みたる細溪川の忘られぬかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0035",
   "pid": "916448",
   "pages": [
    37
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "時としてまた遠き山をおもふわがこころいまは疲れぬ時じくの山の雫に行きて濡れましを高山のそのいただきに額あげて風の寒きに觸れましものをたのしきはわれを忘れて曉の峰はなれゆく雲あふぐ時",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0036",
   "pid": "916448",
   "pages": [
    38
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "夜ならばまた來てやどれしののめの峰はなれゆく夏の白雲天そそる峰にたなびきうち凍り峽にたたなはる夏のしら雲古句に山高而月小とかありけむさびしさや峰高ければ小さしといひけむその月を見む",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0037",
   "pid": "916448",
   "pages": [
    39
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "さびしき樹木",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0038",
   "pid": "916448",
   "pages": [
    40
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "或夜風冴えて月清しうろこ雲空にながれてしらじらと輝けるかげの夏の夜の月",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0039",
   "pid": "916448",
   "pages": [
    41
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ひさしくも見ざりしごときおもひしてけふあふぐ月の澄めるいろかも見てあれば見てあるほどにうろこ雲ながれ速みて冴ゆる月かげ軒端なる欅の並木さやさやに細葉そよぎて月更けにけり欅の木の葉を茂みかも月の夜に宿れる風の聞きのよろしき",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0040",
   "pid": "916448",
   "pages": [
    42
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "或時はひとのものいふ聲かとも月の夜ふけの葉ずれ聞え來或る朝井戸端にわが浴び浴ぶる水の音水のたえまに蜩きこゆ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0041",
   "pid": "916448",
   "pages": [
    43
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "醉ひざめに限るべしやは起き出でて朝井戸に飮むこの水の味起き出でて裸足に立てる朝庭の冷き土に媚ぶるこころかひんがしの白みそむれば物かげに照りてわびしきみじか夜の月",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0042",
   "pid": "916448",
   "pages": [
    44
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "また或る朝疲れつつ起き出で來ればみじか夜の月殘りゐて黍の葉の影夙く起きて靜かに居れば庭さきの黍の葉ずゑの露もまだ散らず朝起きの眞澄かなしきわがこころみださじものと疲れるにけり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0043",
   "pid": "916448",
   "pages": [
    45
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "あやふきは黍の葉ずゑのつゆよりも朝げしばしのわが靜心疲れたるひとのみぞ知るしののめの露の干ぬまのこのたのしさは朝の漸う深みゆくに此處はなほものかげなれど朝空を輝きてゆく白鷺の鳥",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0044",
   "pid": "916448",
   "pages": [
    46
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "あをあをと朝日さしゐて森の奧聲のかぎりの蜩きこゆ庭の畑庭の隅わがつくりたる黍畑にちさき露見え朝朝晴るる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0045",
   "pid": "916448",
   "pages": [
    47
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "秋近しいつとなく黑みて見ゆる楢の葉に今朝ふく風のあはれなるかも暫くは世のことぐさを思はずてひとりぞあらむこの朝風に",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0046",
   "pid": "916448",
   "pages": [
    48
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "窓の眞畫ふつとして額あぐればわが窓に燃えてのぞめる花柘榴花見上ぐれば窓いつぱいの欅の木椎の木の蔭の花柘榴花",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0047",
   "pid": "916448",
   "pages": [
    49
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "柘榴の花欅の木椎の木の葉のしづもりの蔭に燃えたる花ざくろ花見てあれば見てあるほどに柘榴花くれなゐ燃えて枝にそよがず觸れがたきものにこそあれ水無月の曇りのかげに咲ける柘榴花",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0048",
   "pid": "916448",
   "pages": [
    50
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "汗もいま湧きか止まらむ柘榴花咲きみちて枝に燃ゆるならずやたましひよ萎えしといふな眞夏日のひかりのなかに柘榴は咲けり或時はひつそりとして葉がくれに悲しめるごとき花ざくろ花日のひかりかげり來れば枝枝の柘榴の花は搖れてそよげり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0049",
   "pid": "916448",
   "pages": [
    51
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "窓より大きなる銀杏の木見ゆ朝霧のやや晴れゆけば夏の日の靑み輝き銀杏は立てり濃みどりの銀杏の葉かげこまごまと朝日やどりて風そよぐ見ゆ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0050",
   "pid": "916448",
   "pages": [
    52
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "欅の枝と雀すずめ子の一羽とまりて啼く見ればあをき細枝に朝日さゆらぐ午前窓漏れてあざやけきかな七月の靑きひかりはわれの机に",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0051",
   "pid": "916448",
   "pages": [
    53
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "眞晝欅の葉ほのかにゆれて窓靑みチヤルメラの笛とほく聞ゆるとほき木に蟬の鳴き入りゆくなり出でし時計音のわびしも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0052",
   "pid": "916448",
   "pages": [
    54
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "また或る午前に枝の葉にやどり輝く夏の日のひかりがなしきこの朝かなをりをりにひとみ上ぐれば窓を掩ふ欅の枝にまだ朝のひかり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0053",
   "pid": "916448",
   "pages": [
    55
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "午睡輝きて睡眠は來る午ちかみ窓邊の木の葉照り靑みつつ或る夜蚊帳のなかに机持ち入れもの書くと夜を起きて居れば蚊の聲さびし",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0054",
   "pid": "916448",
   "pages": [
    56
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "蚊帳に見ゆる夜ふけの風の冷きにこころ覺め居れば蚊のなく聞ゆをりをりに吹き入る風の蚊帳をあふりこころさびしも秋のごときにいつしかも凪ぎぬる風か立ち出でて緣より見れば黑き夜の木木月夜にはあらねうすらに明りゐて秋めける空にならぶ木の數",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0055",
   "pid": "916448",
   "pages": [
    57
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "いまをかも露のおくらむ夜あかりに長く垂れたる黍の葉の見ゆほどちかく行ける夜汽車の音すらもなつかしくしてもの書きいそぐたまたまに夜半を起きゐてもの書けば夜のめづらしく灯のめづらしく曉ちかきものの冷かもしみじみと庭のあたりに蟲なきしきる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0056",
   "pid": "916448",
   "pages": [
    58
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "眠らじとつとめつとめつ現なく蟲のこゑ聞けば夜は深からし額を手にささえてをればそのままに眠らむとする夜仕事あはれふとしては蟲かとまがふ夜仕事に疲れて居ればわれの耳鳴り",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0057",
   "pid": "916448",
   "pages": [
    59
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "七月なかばいま蒔かむものはと問ひて買ひて來し二十日太根の種をこそ蒔け二十日大根二尺づつ角に鋤きたる土のうへにはらはら蒔けるものの種かも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0058",
   "pid": "916448",
   "pages": [
    60
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "蒔きてまだ三日もたたぬに黑土にはつはつ萌えぬ二十日大根は北國行",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0059",
   "pid": "916448",
   "pages": [
    61
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "板谷峠おしなべて汽車のうちさへしめやかになりゆくものか溪見えそめぬ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0060",
   "pid": "916448",
   "pages": [
    62
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "たけ長く引きてしらじら降る雨の峽の片山に汽車はかかれりいづかたへ流るる瀨瀨かしらじらと見えてとほき峽の細溪院内峠峽ごしに汽車よりあふぐ高嶺には雲ひかりゐて窓に雨鋭し",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0061",
   "pid": "916448",
   "pages": [
    63
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "汽車のうちも光り明るむここちして四方の雨しるき秋草の原筋あらく汽車に降り入る山の雨手にもとるごと光りてぞ見ゆ最上川最上川岸の山群むきむきに雲籠るなかを濁り流るる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0062",
   "pid": "916448",
   "pages": [
    64
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "中高にうねり流るる出水河最上の空は秋ぐもりせり初めて酒田港を見るささ舟の鰺つり舟か烏賊つりかわづか群れゐぬ羽後の酒田は",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0063",
   "pid": "916448",
   "pages": [
    65
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "同港滯在ゆきずりの旅人同士最上川に手洗ひつつ語る妓買話はるばると羽後の酒田に妓買に來しとにはあらね來てみれば面白",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0064",
   "pid": "916448",
   "pages": [
    66
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "汽船にて酒田港を出づ大最上海にひらくるところには風もいみじく吹きどよみ居り砂山の蔭に早やなりぬひとのごと別れの惜しき酒田の港",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0065",
   "pid": "916448",
   "pages": [
    67
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "海路きりぎしの眞下に立てるむら岩に浪はむらがり沖邊晴れたり海ぎしの低山に雲のこごりゐて邊浪朝浪あざやけきかも",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0066",
   "pid": "916448",
   "pages": [
    68
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "海上鳥海山遠望あまたたび見むとはすれど陸のかぎり朝雲這ひて鳥海山無し乳こごる濃き雲とけて朝風の立つらしきさまや遠き鳥海山",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0067",
   "pid": "916448",
   "pages": [
    69
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "島見ゆ、飛島とかやふと見れば雲のかげなるあはあはしき光のなかに飛島の見ゆ晴れたれど暗みをやどす夏の海の沖津邊のかたに飛島浮けり",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0068",
   "pid": "916448",
   "pages": [
    70
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "飛島の影消えしころ粟島見ゆいまは早やまさしくなりし粟島の岸に立つ浪しらじらと見ゆ飛島と粟島といふ荒海に飛びてうかべる粟のごとき島",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0069",
   "pid": "916448",
   "pages": [
    71
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "船上飛の魚のとびはぬる海の靜かにて船にこもれば船もまた光るゆきゆくに沖に浪なく船に音なしさびしければぞ陸を見て居るなかば覺めなかばねむりて船に見るここの海ぎしの岩の渦浪",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0070",
   "pid": "916448",
   "pages": [
    72
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "浪しろき岸邊岸邊にそひてゆくひと日の船の乘合の顏兩眼を見ひらきながらねむり居るごときおもひを船の上にしつひとつらに低く見えをる陸のうへのこの國の山は誰も名を知らず國人もその名を知らぬ低山の峰こそつづけ夏雲のかげに",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0071",
   "pid": "916448",
   "pages": [
    73
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "斯くしつつ幾日もゆけど浪のなかのこれの汽船をいとしく思ふ沖津邊の浪のかたちに傾きてやがては直る船の上の眞晝ねころびてせうともなき船の上のおもひにのぼるさまざまの人身は船にありてふとも忘れつつもの思ひをればさびしうなりぬ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0072",
   "pid": "916448",
   "pages": [
    74
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "さまざまのひとを思ひ倦み起き直り船より見たる沖津邊の浪藍の泡のながれただよふ岩の間の汐のとろみに魚釣らましをざざと引くしら浪の岩に居る烏の三つ二つ見えて浪さらに上る",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0073",
   "pid": "916448",
   "pages": [
    75
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "船中獨酌たへかねてとり出したる酒の壜いまだ飲まねばくちもとに滿てり近く見え手にもとるべき島山か酒飲みて居れば四方は明らかふらふらと醉かも身には廻るらし甲板の小蔭に酒飲みをれば",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0074",
   "pid": "916448",
   "pages": [
    76
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "斷崖盡きて遠き砂丘起ろ、地圖を見れば越後の如し崖盡きて光り起れる砂濱のひくくつづけり越後の國は越後てふ聞のひさしくなつかしき國かも松の濱見えそめぬ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0075",
   "pid": "916448",
   "pages": [
    77
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "日沒近く佐渡島見ゆ羽後の海朝けぶりゐき越え來れば越後の海は夕けぶりつつこの海にへなりて浮ける三つの島をひと日この船にとびとびに見つ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0076",
   "pid": "916448",
   "pages": [
    79
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "木槿の花見しといはば見しにも似たれこの秋の木槿の花の影のとほさよ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0077",
   "pid": "916448",
   "pages": [
    80
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "際白く奧むらさきのよき花の木槿おもへば秋の日かなし淀の深みにうかべる魚のごとくにて或る日行き居れば木槿さきゐたりこの年の秋もなかばを過ぎぬるとおもふこころに木槿浮び見ゆ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0078",
   "pid": "916448",
   "pages": [
    81
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "原疲れてはひそかに來り草を見るこの荒原の秋の幾日櫟の木まばらにならび秋くさの荒れしこの原ひとは知らなく",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0079",
   "pid": "916448",
   "pages": [
    82
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "失題新しき世界の見ゆといふことの言葉ばかりもかなしきものをあたらしきわれの踏むべき新しきかなしき地のまざまざと見ゆここにして身をし淨めよあたらしきわが日のなかにあたらしく行け",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0080",
   "pid": "916448",
   "pages": [
    83
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "罹病禁酒底なしの甕に水をつぐごとくすべなきものか酒やめて居れば咳吐かむちからも腹にいまはなし白けからびて罅入りてあらむ膳にならぶ飯も小鯛も松たけも可笑しきものか酒なしにして",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0081",
   "pid": "916448",
   "pages": [
    84
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "ほほとのみ笑ひ向はむ酒なしの膳のうへにぞ涙こほるる古川滴泉君より林檎を送られしに答ぶる歌みちのくの小學校の校長のその妹と送りこし林檎",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0082",
   "pid": "916448",
   "pages": [
    85
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "山の村の學校なれば晝間とて靜けかるらむ何してか友よ年わかく笑みこぼしつつ兒等を見る校長ぶりを見に行かないまに君が頰にをりをりうかぶうなゐなす丹の頰のふりををりをり思ふ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0083",
   "pid": "916448",
   "pages": [
    86
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "久しぶりに和田山蘭君に寄する歌ちからなく喋みてありや腹黑くかまへて居るかいづれかはいへ友としてちからを持たぬ時時のわれは見ゆらめどうとんずなゆめ罵ると汝をする時しみづからのちから危しこころは冷ゆる",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0084",
   "pid": "916448",
   "pages": [
    87
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "おほよそにおもひ棄つるなひとすぢに思ひ入りたることは尊し酒のみのわれとおれとが酒なしに向ひあふことも或るとき可けむ（彼も亦病めりとか）福地房志君より鮎を送られしに答ふる歌秋山のはざまの溪の瀧つ瀨の出水する待ちて取りし鮎とふ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0085",
   "pid": "916448",
   "pages": [
    88
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "たぎり落つる濁りに投げし網のうちに落葉朽葉とおごりけむ鮎岩山の黃葉ちり積る溪のおくにいまだ居けむこの鏽鮎は落鮎の姿は瘦せたれ岩出でて黃葉でし溪をおもひつつ食ふおなじくば汝が古家の大圍爐裡かこみて燒きてともに食はましを",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0086",
   "pid": "916448",
   "pages": [
    89
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "小河原業山君より松茸を送られしに答ふる歌ところどころ赤く禿げたる松山の端山がなかの友が村の秋松茸のかをりを嗅げば村住の友がこころに觸るるおもひす秋の日はまさしくさして籠りゐの緣の板さへそりてぞあらむ",
   "sachu": "",
   "poems": []
  },
  {
   "id": "wakayama-bokusui-916448-0087",
   "pid": "916448",
   "pages": [
    90
   ],
   "no": null,
   "maki": "",
   "bu": "",
   "dai": "",
   "kotobagaki": "",
   "author": "",
   "text": "雀雀すずめのなかのただ一羽庭に降りきと君が眼は動け—をはり—大正七年七月十九日印刷大正七年七月廿三日發行定價金七拾錢さびしき樹木著作者若山東京市芝區新堀町三十七番地發行者石川甲作東京市本鄕區湯島切通坂町五十一番地印刷者加藤晴吉印刷所東京市本鄕區湯島切通坂町五十一番地合資會社正文舍發行所東京市芝區新堀町三十七番地南光書院振替貯金東京三八〇七九番",
   "sachu": "",
   "poems": []
  }
 ],
